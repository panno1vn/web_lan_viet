{
  "name": "lan-viet-shop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Website bán hoa lan - React (Vite) + react-router + Express API, áp dụng các quy tắc bảo mật môn An toàn ứng dụng web và CSDL",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"node --env-file-if-exists=.env --watch server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js --production",
    "audit": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.4"
  }
}
