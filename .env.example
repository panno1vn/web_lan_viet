# Sao chép thành .env và chỉnh theo môi trường. KHÔNG commit file .env thật.
NODE_ENV=development
# PORT=3001
# Đường dẫn file SQLite (đặt ngoài thư mục web)
# DB_PATH=./server/data/shop.db
# Các origin được phép gửi request thay đổi dữ liệu (phân tách bằng dấu phẩy)
ALLOWED_ORIGINS=http://localhost:3000
# Đặt 1 khi chạy sau reverse proxy có HTTPS (nginx, Render, ...)
TRUST_PROXY=0
FORCE_HTTPS=0
